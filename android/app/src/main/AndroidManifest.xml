<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CrateApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Crate"
        android:supportsRtl="true"
        android:theme="@style/Theme.Crate">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Spotify login callback and crate:// links (now, open, track/<id>, send?preset=<id>) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="crate" />
            </intent-filter>
        </activity>
        <!-- Spotify → Share → Crate: a bottom sheet over the sharing app (track tags, More like this → Now, Like) -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/Theme.Crate.Share"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets (Glance) -->
        <receiver
            android:name=".widget.PresetWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_preset_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_preset" />
        </receiver>
        <receiver
            android:name=".widget.GridWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_grid_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_grid" />
        </receiver>
        <!-- Small widget: which preset it sends -->
        <activity
            android:name=".widget.PresetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_label"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
